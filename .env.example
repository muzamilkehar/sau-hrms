# ---- Database (PostgreSQL). Neon: use the POOLED connection string here.
DATABASE_URL=
# Neon only: the DIRECT (non-pooled) connection string, used for migrations. Leave empty for local PostgreSQL.
DIRECT_URL=""
# Database used by the integration tests. The name MUST contain "test": every table is emptied.
TEST_DATABASE_URL=

# ---- Authentication (Better Auth)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
# Public URL of the app (http://localhost:3000 in development)
BETTER_AUTH_URL=

# ---- Email (Resend). If RESEND_API_KEY is empty, emails are printed to the terminal.
RESEND_API_KEY=
EMAIL_FROM=

# ---- Rate limiting (Upstash Redis). Optional in development; recommended in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- First HR/Admin account, used by `npm run db:seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_LAST_NAME=
# 12+ characters, mixed letters/numbers/symbols, must not contain the name or email name
SEED_ADMIN_PASSWORD=

# ---- Optional demo data (4 employees with attendance, leave requests and payroll)
SEED_DEMO_DATA=
SEED_DEMO_PASSWORD=
